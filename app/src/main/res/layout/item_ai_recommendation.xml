<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="145dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/spotify_dark_gray"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <androidx.cardview.widget.CardView
            android:layout_width="129dp"
            android:layout_height="129dp"
            app:cardCornerRadius="6dp">

            <ImageView
                android:id="@+id/imgRecCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#2E2E2E"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_library"
                app:tint="@color/spotify_green" />
        </androidx.cardview.widget.CardView>

        <!-- AI Reason Badge -->
        <TextView
            android:id="@+id/tvRecReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ai_badge"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="✨ Hợp gu Acoustic"
            android:textColor="@color/spotify_white"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tên bài hát"
            android:textColor="@color/spotify_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tên ca sĩ"
            android:textColor="@color/spotify_light_gray"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
