<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_drawer_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="#2E2E2E"
        android:padding="8dp"
        android:src="@drawable/ic_music_note"
        app:tint="@color/spotify_green" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvManagePlaylistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Giai Điệu Acoustic Chill"
            android:textColor="@color/spotify_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvManagePlaylistStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Hiển thị trên trang cá nhân"
            android:textColor="@color/spotify_light_gray"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Switch to show/hide on profile -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swManageVisibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        app:thumbTint="@color/spotify_white"
        app:trackTint="@color/spotify_green" />

</LinearLayout>
